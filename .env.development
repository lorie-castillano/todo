# Local development environment
# Vite loads this automatically when running `npm run dev`

VITE_APP_NAME=Todo App
VITE_APP_VERSION=0.0.0

# Empty = use relative URLs (MSW intercepts /api/* in dev)
VITE_API_BASE_URL=

# Enable React Query Devtools in dev
VITE_FEATURE_DEVTOOLS=true
VITE_FEATURE_PERFORMANCE_MONITORING=false
