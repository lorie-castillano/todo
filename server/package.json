{
  "name": "todo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify backend for the Todo app — REST API + MCP server for AI agents",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
