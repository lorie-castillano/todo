# Copy this file to .env.development for local dev
# NEVER commit .env files with real secrets to git

# App metadata
VITE_APP_NAME=Todo App
VITE_APP_VERSION=0.0.0

# API base URL — override in production to point to your real API
VITE_API_BASE_URL=

# Sentry error reporting and performance monitoring
# Get DSN from: https://sentry.io → Project Settings → Client Keys
# Leave empty in development — Sentry is disabled when not set
VITE_SENTRY_DSN=

# Feature flags — set to "true" to enable
VITE_FEATURE_DEVTOOLS=false
VITE_FEATURE_PERFORMANCE_MONITORING=false
