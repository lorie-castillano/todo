# Copy this file to .env for local development.
# .env is gitignored — never commit real secrets.

# Server port and host
PORT=3000
HOST=0.0.0.0

# Runtime environment: development | production | test
NODE_ENV=development

# Minimum log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Allowed CORS origin (the frontend dev server)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (matches docker-compose.yml defaults)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://todo_user:todo_pass@localhost:5432/todo_dev?schema=public

# Optional: Redis connection for a SHARED rate-limit store.
# Required for horizontal scaling (multiple backend instances) so the
# rate-limit counter is global. If unset, the limiter falls back to an
# in-memory per-process store (fine for single-instance local dev).
# REDIS_URL=redis://localhost:6379

# Optional: Redis URL for shared rate-limit store (recommended for production).
# When unset, the rate limiter uses per-process in-memory counters (fine for
# single-instance local dev, wrong for multi-instance horizontal scaling).
#
# Example: redis://localhost:6379
REDIS_URL=

# Optional: MCP API key for agent authentication (required in production).
# Generate with: openssl rand -hex 32
# Agents must include this key in tool calls to authenticate.
MCP_API_KEY=

# Optional: public base URL advertised in the A2A agent card.
# Defaults to http://localhost:<PORT>. In production, set this to the
# external HTTPS URL that other agents use to reach this server.
A2A_BASE_URL=
