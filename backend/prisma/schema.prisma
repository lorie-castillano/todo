// Prisma schema — the single source of truth for the database structure.
//
// When you change this file:
//   npx prisma migrate dev --name <description>   → creates a migration
//   npx prisma generate                           → regenerates the TS client
//
// Key design decisions:
// - autoincrement Integer id (matches frontend's branded TodoId = number)
// - createdAt / updatedAt for audit trail
// - deletedAt for soft deletes (null = active, timestamp = deleted)
// - index on (completed, deletedAt) for the most common query: filter by status

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // UUID for user IDs. Using string lets us integrate with external identity
  // providers (OAuth, SSO) without remapping IDs later.
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String   // bcrypt hash, never plaintext

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  todos         Todo[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// A long-lived refresh token used to mint new short-lived access tokens.
//
// Security design:
// - We store only a SHA-256 HASH of the token, never the raw value. A DB leak
//   therefore can't be used to forge sessions (the raw token lives only in the
//   user's httpOnly cookie).
// - Rotation: every /refresh issues a new token and revokes the old one. If a
//   stolen token is replayed after rotation, verification fails.
// - revokedAt: soft-revoke for logout and rotation, keeping an audit trail.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid

  // SHA-256 hex digest of the raw token. Unique so lookups are O(1) by hash.
  tokenHash String    @unique @map("token_hash")

  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Look up a user's active tokens quickly (e.g., revoke-all on password change).
  @@index([userId])

  @@map("refresh_tokens")
}

model Todo {
  // Autoincrement integer matches the frontend's `TodoId = number & { __brand }`
  id        Int      @id @default(autoincrement())

  // The todo text. Can't be empty (enforced at the app layer with Zod).
  text      String

  // Completion status. Defaults to false on creation.
  completed Boolean  @default(false)

  // --- Ownership ---
  // Every todo belongs to a user. Now required: auth is enforced and all
  // requests pass an authenticated userId. The database rejects ownerless rows.
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Audit timestamps ---
  // `createdAt` is set once on insert, never changes.
  // `updatedAt` is refreshed automatically by Prisma on every update.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  // --- Soft delete ---
  // null = active record. A timestamp = when it was "deleted".
  // Queries filter on `deletedAt IS NULL` to hide soft-deleted rows.
  deletedAt DateTime?                  @map("deleted_at")

  // --- Indexes ---
  // The frontend's most common query is "show me active/completed todos".
  // A composite index on (userId, completed, deletedAt) scopes every query
  // to the authenticated user first, which is critical for performance and privacy.
  @@index([userId, completed, deletedAt])

  // Use snake_case table name (PostgreSQL convention).
  @@map("todos")
}
